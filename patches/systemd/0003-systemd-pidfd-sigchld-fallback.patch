                         assert(s->child.pid > 0);
-                        assert(s->child.pidfd >= 0);
 
                         if (!s->child.exited) {
-                                r = RET_NERRNO(pidfd_send_signal(s->child.pidfd, SIGKILL, NULL, 0));
+                                if (s->child.pidfd >= 0)
+                                        r = RET_NERRNO(pidfd_send_signal(s->child.pidfd, SIGKILL, NULL, 0));
+                                else
+                                        r = RET_NERRNO(kill(s->child.pid, SIGKILL));
                                 if (r < 0 && r != -ESRCH)
                                         log_debug_errno(r, "Failed to kill process " PID_FMT ", ignoring: %m",
                                                         s->child.pid);
@@ -1111,7 +1128,7 @@
                                 siginfo_t si = {};
 
                                 /* Reap the child if we can */
-                                (void) waitid(P_PIDFD, s->child.pidfd, &si, WEXITED);
+                                (void) child_waitid(s, &si, WEXITED);
                         }
                 }
 
@@ -1648,8 +1665,14 @@
          * PID, and make regular waitid() handling race-free. */
 
         s->child.pidfd = pidfd_open(pid, 0);
-        if (s->child.pidfd < 0)
-                return -errno;
+        if (s->child.pidfd < 0) {
+                /* pidfd_open() is Linux 5.3. Below that, fall back to the SIGCHLD path this file still
+                 * carries for the non-WEXITED case, rather than refusing to watch children at all. */
+                if (!ERRNO_IS_NOT_SUPPORTED(errno))
+                        return -errno;
+
+                s->child.pidfd = -EBADF;
+        }
 
