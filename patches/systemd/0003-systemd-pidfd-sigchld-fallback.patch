+        if (s->child.pidfd < 0) {
+                /* No pidfd_send_signal() before Linux 5.1. The pid is not pinned in that case, but
+                 * neither is anything else on such a kernel. */
+                assert(s->child.pid > 0);
+
+                if (si)
