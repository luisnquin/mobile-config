 int seccomp_arch_from_string(const char *n, uint32_t *ret);
 
+uint32_t scmp_act_kill_process(void);
+
 int seccomp_init_for_arch(scmp_filter_ctx *ret, uint32_t arch, uint32_t default_action);
 
 bool is_seccomp_available(void);
--- a/src/shared/seccomp-util.c
+++ b/src/shared/seccomp-util.c
@@ -1201,6 +1201,28 @@
         return 0;
 }
 
+uint32_t scmp_act_kill_process(void) {
+
+        /* SCMP_ACT_KILL_PROCESS needs libseccomp 2.4.0 on the userspace side and
+         * SECCOMP_RET_KILL_PROCESS in the kernel, which arrived in 4.14.  libseccomp reports both
+         * through its API level: level 3 is defined as the level at which SECCOMP_RET_LOG and
+         * SECCOMP_RET_KILL_PROCESS are usable, and seccomp_api_get() probes the running kernel
+         * rather than reporting a build-time constant.
+         *
+         * Below that, fall back to SCMP_ACT_KILL, which is SECCOMP_RET_KILL_THREAD and has been
+         * there since 3.5.  The difference is which of the two the kernel tears down on a
+         * violation, the thread or the whole process; for a filter that is meant to be fatal
+         * either is a defensible answer, and it is the only one available here. */
+
+        if (dlopen_libseccomp(LOG_DEBUG) < 0)
+                return SCMP_ACT_KILL;
+
+        if (sym_seccomp_api_get() >= 3)
+                return SCMP_ACT_KILL_PROCESS;
+
+        return SCMP_ACT_KILL;
+}
+
 int seccomp_load_syscall_filter_set_raw(uint32_t default_action, Hashmap* filter, uint32_t action, bool log_missing) {
         uint32_t arch, default_action_override;
         int r;
@@ -1233,7 +1255,7 @@
