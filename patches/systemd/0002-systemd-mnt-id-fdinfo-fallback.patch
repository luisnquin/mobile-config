systemd: recover the mount id from /proc/self/fdinfo on pre-5.8 kernels

systemd 261 chase() calls xstatx_full() with XSTATX_MNT_ID_BEST and refuses to
continue when statx() reports no mount id.  STATX_MNT_ID landed in Linux 5.8 and
statx() itself in 4.11; this port's kernel is the vendor 4.9.190, where glibc
emulates statx() from fstatat() and reports STATX_BASIC_STATS only.  Every chase()
therefore returns -EUNATCH, which on dandelion made sd-device fail 1067 sysfs
lookups and killed 'udevadm trigger --action=add' in Mobile NixOS stage-1
(lab/dandelion/V12.0.22.0.QCDMIXM/logs/stage1-attempt13/udevadm-debug.txt).

The old-style mount id is exposed per-fd in /proc/self/fdinfo since Linux 3.15, so
read it from there rather than failing.  name_to_handle_at() is not an option: it
fails on sysfs, which is exactly where sd-device needs the value.

Upstream is unlikely to take this: systemd's baseline is far above 4.9.  It is
carried here because the dandelion port has no newer kernel available.

--- a/src/basic/stat-util.c	2026-07-31 11:54:37.280602372 -0500
+++ b/src/basic/stat-util.c	2026-07-31 11:55:24.001733194 -0500
@@ -11,14 +11,17 @@
 #include "dirent-util.h"
 #include "errno-util.h"
 #include "fd-util.h"
+#include "fileio.h"
 #include "filesystems.h"
 #include "fs-util.h"
 #include "hash-funcs.h"
 #include "log.h"
 #include "mountpoint-util.h"
+#include "parse-util.h"
 #include "path-util.h"
 #include "siphash24.h"
 #include "stat-util.h"
+#include "stdio-util.h"
 #include "string-util.h"
 #include "time-util.h"
 
@@ -395,6 +398,58 @@
 DEFINE_STATX_BITS_TO_STRING(statx_mask,       unsigned, statx_mask_one_to_name,  "0x%x");
 DEFINE_STATX_BITS_TO_STRING(statx_attributes, uint64_t, statx_attribute_to_name, "0x%" PRIx64);
 
+static int mnt_id_from_fdinfo(int fd, const char *path, int statx_flags, uint64_t *ret) {
+
+        /* STATX_MNT_ID needs Linux 5.8, and statx() itself needs 4.11 -- below that glibc emulates the
+         * call from fstatat() and reports STATX_BASIC_STATS only. The old-style mount id has been in
+         * /proc/self/fdinfo/ since 3.15, so on such kernels recover it from there instead of refusing to
+         * operate. name_to_handle_at() is not usable as a fallback here: it fails on sysfs, which is
+         * precisely where sd-device needs the mount id. */
+
+        _cleanup_close_ int pin = -EBADF;
+        _cleanup_free_ char *fdinfo = NULL, *value = NULL;
+        char procfs[STRLEN("/proc/self/fdinfo/") + DECIMAL_STR_MAX(int)];
+        const char *e;
+        int r, probe_fd;
+
+        assert(ret);
+
+        if (isempty(path) && fd >= 0)
+                probe_fd = fd;
+        else {
+                pin = openat(fd, strempty(path),
+                             O_PATH|O_CLOEXEC|
+                             (FLAGS_SET(statx_flags, AT_SYMLINK_NOFOLLOW) ? O_NOFOLLOW : 0));
+                if (pin < 0)
+                        return -errno;
+
+                probe_fd = pin;
+        }
+
+        xsprintf(procfs, "/proc/self/fdinfo/%i", probe_fd);
+
+        r = read_full_virtual_file(procfs, &fdinfo, NULL);
+        if (r < 0)
+                return r;
+
+        e = startswith(fdinfo, "mnt_id:");
+        if (!e) {
+                e = strstr(fdinfo, "\nmnt_id:");
+                if (!e)
+                        return -EUNATCH;
+
+                e += 1 + STRLEN("mnt_id:");
+        }
+
+        e += strspn(e, " \t");
+
+        value = strndup(e, strcspn(e, "\n"));
+        if (!value)
+                return -ENOMEM;
+
+        return safe_atou64(value, ret);
+}
+
 int xstatx_full(int fd,
                 const char *path,
                 int statx_flags,
@@ -440,8 +495,18 @@
                 return negative_errno();
 
         if (FLAGS_SET(xstatx_flags, XSTATX_MNT_ID_BEST) &&
-            !(sx.stx_mask & (STATX_MNT_ID|STATX_MNT_ID_UNIQUE)))
-                return log_debug_errno(SYNTHETIC_ERRNO(EUNATCH), "statx() did not return either STATX_MNT_ID or STATX_MNT_ID_UNIQUE.");
+            !(sx.stx_mask & (STATX_MNT_ID|STATX_MNT_ID_UNIQUE))) {
+                uint64_t mnt_id;
+
+                r = mnt_id_from_fdinfo(fd, path, statx_flags, &mnt_id);
+                if (r < 0) {
+                        log_debug_errno(r, "statx() returned neither STATX_MNT_ID nor STATX_MNT_ID_UNIQUE, and /proc/self/fdinfo carries no mount id either: %m");
+                        return -EUNATCH;
+                }
+
+                sx.stx_mnt_id = mnt_id;
+                sx.stx_mask |= STATX_MNT_ID;
+        }
 
         if (!FLAGS_SET(sx.stx_mask, mandatory_mask)) {
                 if (DEBUG_LOGGING) {
