From bbca6f73b57817e2d7b701968b988817204023ee Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Wed, 16 Aug 2023 08:34:30 +0400
Subject: [PATCH 42/91] phy: mediatek: phy-mtk-mipi-dsi: Add support for MT6765
 DSI PHY

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 drivers/phy/mediatek/phy-mtk-mipi-dsi.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/phy/mediatek/phy-mtk-mipi-dsi.c b/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
index 065ea6260..17e76327c 100644
--- a/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
+++ b/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
@@ -181,6 +181,7 @@ static int mtk_mipi_tx_probe(struct platform_device *pdev)
 
 static const struct of_device_id mtk_mipi_tx_match[] = {
 	{ .compatible = "mediatek,mt2701-mipi-tx", .data = &mt2701_mipitx_data },
+	{ .compatible = "mediatek,mt6765-mipi-tx", .data = &mt8173_mipitx_data },
 	{ .compatible = "mediatek,mt8173-mipi-tx", .data = &mt8173_mipitx_data },
 	{ .compatible = "mediatek,mt8183-mipi-tx", .data = &mt8183_mipitx_data },
 	{ /* sentinel */ }
