From c63492cf427d2bc40fa03f3b4d281598c47989f0 Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Sun, 13 Aug 2023 21:00:44 +0400
Subject: [PATCH 09/91] arm64: dts: mediatek: mt6765: Add watchdog

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt6765.dtsi | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6765.dtsi b/arch/arm64/boot/dts/mediatek/mt6765.dtsi
index 52b15762b..44365a004 100644
--- a/arch/arm64/boot/dts/mediatek/mt6765.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6765.dtsi
@@ -189,6 +189,13 @@ apmixed: syscon@1000c000 {
             #clock-cells = <1>;
         };
 
+        // TODO: Add reset support
+        watchdog: watchdog@10007000 {
+            compatible = "mediatek,mt6589-wdt";
+            reg = <0 0x10007000 0 0x100>;
+            interrupts = <GIC_SPI 139 IRQ_TYPE_LEVEL_LOW>;
+        };
+
         usb2: usb@11200000 {
             compatible = "mediatek,mtk-musb";
             reg = <0 0x11200000 0 0x1000>;
