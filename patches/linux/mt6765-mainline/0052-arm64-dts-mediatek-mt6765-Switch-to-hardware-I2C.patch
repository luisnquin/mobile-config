From c6c182317e91f1a2de11b91ec7d11572afd5f34f Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Wed, 16 Aug 2023 11:17:47 +0400
Subject: [PATCH 52/91] arm64: dts: mediatek: mt6765: Switch to hardware I2C

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt6765.dtsi | 197 +++++++++++++++++++----
 1 file changed, 168 insertions(+), 29 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6765.dtsi b/arch/arm64/boot/dts/mediatek/mt6765.dtsi
index a2401de34..377d5fdc7 100644
