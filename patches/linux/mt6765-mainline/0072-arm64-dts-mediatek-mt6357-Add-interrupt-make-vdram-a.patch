From 0a1e2137cdd9ef9ee68dfce94fb00982c8e4bf7d Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Wed, 23 Aug 2023 00:20:05 +0400
Subject: [PATCH 72/91] arm64: dts: mediatek: mt6357: Add interrupt && make
 vdram always-on

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt6357.dtsi | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6357.dtsi b/arch/arm64/boot/dts/mediatek/mt6357.dtsi
index dca4e5c3d..8dcc20cc1 100644
--- a/arch/arm64/boot/dts/mediatek/mt6357.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6357.dtsi
@@ -9,6 +9,10 @@
 &pwrap {
 	mt6357_pmic: pmic {
 		compatible = "mediatek,mt6357";
+		interrupt-controller;
+		interrupt-parent = <&pio>;
+		interrupts = <144 IRQ_TYPE_LEVEL_HIGH>;
+		#interrupt-cells = <2>;
 
 		pmic_adc: adc {
 			compatible = "mediatek,mt6357-auxadc";
@@ -202,6 +206,7 @@ mt6357_vdram_reg: ldo-vdram {
 				regulator-min-microvolt = <1100000>;
 				regulator-max-microvolt = <1200000>;
 				regulator-enable-ramp-delay = <3300>;
+				regulator-always-on;
 			};
 
 			mt6357_vmc_reg: ldo-vmc {
