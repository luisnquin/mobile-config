From e83dc177b66cda255cd43d83351d392f1284182c Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Sat, 12 Aug 2023 16:36:03 +0400
Subject: [PATCH 02/91] arm64: dts: mediatek: Add initial support for TCL A3

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 arch/arm64/boot/dts/mediatek/Makefile         |  1 +
 .../dts/mediatek/mt6762-tcl-bangkok_tf.dts    | 45 +++++++++++++++++++
 .../boot/dts/mediatek/mt6765-bl-quirks.dtsi   | 23 ++++++++++
 3 files changed, 69 insertions(+)
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6762-tcl-bangkok_tf.dts
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6765-bl-quirks.dtsi

diff --git a/arch/arm64/boot/dts/mediatek/Makefile b/arch/arm64/boot/dts/mediatek/Makefile
index a4df4c213..7ef01124b 100644
--- a/arch/arm64/boot/dts/mediatek/Makefile
+++ b/arch/arm64/boot/dts/mediatek/Makefile
@@ -1,6 +1,7 @@
 # SPDX-License-Identifier: GPL-2.0
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt2712-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6755-evb.dtb
+dtb-$(CONFIG_ARCH_MEDIATEK) += mt6762-tcl-bangkok_tf.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6779-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-sony-xperia-m5.dtb
diff --git a/arch/arm64/boot/dts/mediatek/mt6762-tcl-bangkok_tf.dts b/arch/arm64/boot/dts/mediatek/mt6762-tcl-bangkok_tf.dts
new file mode 100644
index 000000000..fe2f31b11
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6762-tcl-bangkok_tf.dts
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Device Tree Source for TCL A3 (bangkok_tf)
+ *
+ * Copyright (c) 2023 Arseniy Velikanov <adomerlee@gmail.com>
+ * Copyright (C) 2023 Brandon Boese
+ */
+
+/dts-v1/;
+
+#include "mt6765.dtsi"
+#include "mt6765-bl-quirks.dtsi"
+
+/ {
+    model = "TCL A3";
+    compatible = "tcl,bangkok_tf", "mediatek,mt6762", "mediatek,mt6765";
+
+    chosen {
+        stdout-path = &framebuffer0;
+
+        /*
+         * HACK: Use display framebuffer setup by the lk bootloader for simplefb
+         * NOTE: only text is rendered on VT (TTY) as an unknown bit has to be flipped to disable
+         *        image compression!
+         */
+        framebuffer0: framebuffer@7dad0000 {
+            compatible = "simple-framebuffer";
+            reg = <0 0x7dad0000 0 0xe30000>;
+            status = "okay";
+            width = <720>;
+            height = <1440>;
+            stride = <((720 + 16) * 4)>;
+            format = "a8r8g8b8";
+        };
+    };
+
+    /* The following are required by stock bootloader to merge with minimal DTBO */
+    gpio@10005000 {
+        linux,phandle = <0xdead>;
+        phandle = <0xdead>;
+    };
+    __symbols__ {
+        gpio = "/gpio@10005000";
+    };
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt6765-bl-quirks.dtsi b/arch/arm64/boot/dts/mediatek/mt6765-bl-quirks.dtsi
new file mode 100644
index 000000000..fcc33c702
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6765-bl-quirks.dtsi
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Quriks for MT6765 mediatek bootloader (little-kernel)
+ *
+ * Copyright (c) 2023 Arseniy Velikanov <adomerlee@gmail.com>
+ */
+
+#include "mt6765.dtsi"
+
+/ {
+    /* FIXES: [SCP] platform_fdt_scp: getting node from dtb fails */
+    scp@10500000 {
+        compatible = "mediatek,scp";
+        status = "okay";
+        reg = <0x00 0x10500000 0x00 0x40000 0x00 0x105c0000 0x00 0x3000 0x00 0x105c4000 0x00 0x1000 0x00 0x105d4000 0x00 0x6000>;
+        interrupts = <0x00 0xc0 0x04>;
+        core_1 = "enable";
+        scp_sramSize = <0x40000>;
+        scp_feature_tbl = <0x00 0x2f 0x01 0x164 0x02 0x3e 0x03 0x2f 0x04 0x1a 0x05 0x00 0x06 0xc8 0x07 0x00 0x08 0x64 0x09 0x0a>;
+        scp_mem_key = "mediatek,reserve-memory-scp_share";
+        scp_mem_tbl = <0x01 0x100000 0x04 0x200000>;
+    };
+};
