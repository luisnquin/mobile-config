From 8325d4a2b64a051e3b36f364a4d1b5d1fe9f523e Mon Sep 17 00:00:00 2001
From: Ookiineko <chiisaineko@protonmail.com>
Date: Tue, 4 Jun 2024 13:11:17 +0900
Subject: [PATCH 89/91] arm64: dts: mediatek: mt6765-xiaomi-garden: Add some
 LCD regulators

Signed-off-by: Ookiineko <chiisaineko@protonmail.com>
---
 .../mediatek/mt6765-xiaomi-garden-common.dtsi   | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6765-xiaomi-garden-common.dtsi b/arch/arm64/boot/dts/mediatek/mt6765-xiaomi-garden-common.dtsi
index f2c6a63a5..e6388fa98 100644
--- a/arch/arm64/boot/dts/mediatek/mt6765-xiaomi-garden-common.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6765-xiaomi-garden-common.dtsi
@@ -35,6 +35,23 @@ framebuffer0: framebuffer@7ec50000 {
         };
     };
 
+    ldo18_lcd: ldo18-lcd {
+        compatible = "regulator-fixed";
+        regulator-name = "ldo18-lcd";
+        gpio = <&pio 178 GPIO_ACTIVE_HIGH>;
+        enable-active-high;
+        regulator-always-on;  /* hack this on until we get panel driver */
+    };
+
+    lcd_bl: lcd-backlight {
+        compatible = "regulator-fixed";
+        regulator-name = "lcd-bl";
+        gpio = <&pio 154 GPIO_ACTIVE_HIGH>;
+        enable-active-high;
+        regulator-always-on;  /* hack this on until we get panel driver
+                                 remove this line if you don't want to slowly burn your screen */
+    };
+
     /* The following are required by stock bootloader to merge with minimal DTBO */
     gpio@10005000 {
         linux,phandle = <0xdead>;
