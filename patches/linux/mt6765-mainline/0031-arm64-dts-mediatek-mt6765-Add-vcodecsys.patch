From 5b552f367a4d06e4d6957661b7264f05373151c3 Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Wed, 16 Aug 2023 06:46:42 +0400
Subject: [PATCH 31/91] arm64: dts: mediatek: mt6765: Add vcodecsys

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt6765.dtsi | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6765.dtsi b/arch/arm64/boot/dts/mediatek/mt6765.dtsi
index c0c0c5258..8abbf08d3 100644
--- a/arch/arm64/boot/dts/mediatek/mt6765.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6765.dtsi
@@ -203,6 +203,12 @@ camsys: syscon@1a000000  {
             #clock-cells = <1>;
         };
 
+        venc_gcon: syscon@17000000 {
+            compatible = "mediatek,mt6765-vcodecsys", "syscon";
+            reg = <0 0x17000000 0 0x10000>;
+            #clock-cells = <1>;
+        };
+
         // TODO: Add reset support
         watchdog: watchdog@10007000 {
             compatible = "mediatek,mt6589-wdt";
