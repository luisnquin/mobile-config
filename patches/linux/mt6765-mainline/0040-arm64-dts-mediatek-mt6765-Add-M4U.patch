From ab0fd539ee7f176631ab08a354693ab529790a62 Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Wed, 16 Aug 2023 08:10:48 +0400
Subject: [PATCH 40/91] arm64: dts: mediatek: mt6765: Add M4U

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt6765.dtsi | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6765.dtsi b/arch/arm64/boot/dts/mediatek/mt6765.dtsi
index 3bb0b2a70..b5d5013e3 100644
--- a/arch/arm64/boot/dts/mediatek/mt6765.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6765.dtsi
@@ -312,6 +312,18 @@ smi_larb3: memory-controller@1a002000 {
             mediatek,smi = <&smi_common>;
         };
 
+        m4u: iommu@10205000 {
+            compatible = "mediatek,mt6765-m4u";
+            reg = <0 0x10205000 0 0x1000>;
+
+            interrupts = <GIC_SPI 158 IRQ_TYPE_LEVEL_LOW>;
+
+            mediatek,larbs = <&smi_larb0>, <&smi_larb1>,
+                             <&smi_larb2>, <&smi_larb3>;
+
+            #iommu-cells = <1>;
+        };
+
         // TODO: Add reset support
         watchdog: watchdog@10007000 {
             compatible = "mediatek,mt6589-wdt";
